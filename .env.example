# Database (REQUIRED)
# Local: postgresql://postgres:password@localhost:5432/sentry
# Neon (recommended): Get free DB at https://neon.tech
DATABASE_URL=postgresql://user:password@host/sentry?sslmode=require
REDIS_URL=

# Authentication
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Frontend (for Vite)
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
